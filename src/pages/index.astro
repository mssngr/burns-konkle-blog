---
import { Image } from 'astro:assets'
import micala from '@/assets/micala.jpg'
import Mobile from '@/components/mobile.astro'
import { Icon } from '@/components/shell/family-nav'
import { publicModules } from '@/data/modules'
import AppLayout from '@/layouts/app.astro'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')

const blurbs: Record<string, string> = {
  how: 'A quick guide to visiting, dropping off meals, and helping.',
  visits:
    'Request a stay, a house visit, or time with Vincent. Micala or Gabriel review every request.',
  meals:
    'Sign up to leave a meal in the cooler out front. A drop-off, not a visit.',
  offer:
    'Tell us how you’d like to help, and we’ll point you to the right place.',
  registry: 'Things we’d love for the baby, with links to buy each one.',
  updates: 'News, photos, and guessing games from the family.',
  notes: 'Share a loving note, advice, or a picture with the family.',
  rules: 'What we ask of everyone who visits.',
}
const cards = publicModules.filter(m => m.key in blurbs)
---

<AppLayout
  active="home"
  title="Baby Burns-Konkle · Family site"
  description="Visits, meals, help, gifts, and updates around baby Burns-Konkle's arrival."
>
  <header class="home-hero">
    <div class="home-hero-inner">
      <div>
        <Mobile />
        <p class="eyebrow">Arriving mid-December 2026</p>
        <h1>Baby <em>Burns-Konkle</em></h1>
        <p class="lede">
          Thank you for loving Micala, Gabriel, Vincent, and the baby. This is where to plan a visit, drop off a meal, offer
          help, and follow along while the family rests and bonds.
        </p>
      </div>
      <figure class="portrait">
        <Image
          src={micala}
          alt="Micala smiling in a park, holding her pregnant belly"
          widths={[280, 560]}
          sizes="280px"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </header>

  <main class="page">
    <ul class="cards cards-2" style="list-style:none;padding:0;margin:0">
      {
        cards.map(m => (
          <li>
            <a class="card module-card" href={`${base}${m.href}`}>
              <Icon name={m.icon} />
              <h2>{m.label}</h2>
              <p>{blurbs[m.key]}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="muted small" style="margin-top:24px">
      The family’s address is only ever shared personally by the family, never on this site.
    </p>
  </main>

  <script>
    // Old registry links (burns-konkle.com/#item-…) moved to /registry/.
    if (location.hash.length > 1) location.replace(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}registry/${location.hash}`)
  </script>
</AppLayout>
