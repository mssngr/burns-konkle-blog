    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-cantarell" />
    <Font cssVariable="--font-the-nautigal" />
    <title>Burns-Konkle Blog</title>
  </head>
  <body class="m-0 size-screen">
    <slot />
  </body>
</html>
