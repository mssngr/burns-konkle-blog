---
import { Font } from 'astro:assets'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Keep the page out of search results. */
  noindex?: boolean
}
const { title, description, noindex = false } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#26304a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-fraunces" preload />
    <Font cssVariable="--font-figtree" preload />
    <title>{title}</title>
    <script is:inline>
      // GitHub Pages caches HTML for 10 minutes, so right after a deploy a
      // cached page can point at script files that no longer exist and its
      // islands never start. Reload once to pick up the fresh page.
      addEventListener('load', function () {
        setTimeout(function () {
          if (!navigator.onLine || !document.querySelector('astro-island[ssr]'))
            return
          try {
            if (sessionStorage.getItem('stale-reload') === location.pathname)
              return
            sessionStorage.setItem('stale-reload', location.pathname)
          } catch (e) {
            return
          }
          location.reload()
        }, 6000)
      })
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
