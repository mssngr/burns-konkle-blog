---
import type { ShopLink } from '@/data/links'

interface Props {
  label: string
  links?: ShopLink[]
}
const { label, links } = Astro.props
const primary = links?.[0]
---

{
  primary ? (
    <a class="opt-link" href={primary.href} target="_blank" rel="noopener" title={`Open at ${primary.shop}`}>
      {label}
      <svg class="ext-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M11 3h6v6M17 3l-8 8M14 11v4.5a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 3 15.5v-8A1.5 1.5 0 0 1 4.5 6H9" />
      </svg>
      <span class="sr-only"> (opens {primary.shop} in a new tab)</span>
    </a>
  ) : (
    label
  )
}
