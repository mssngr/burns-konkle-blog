---
// A hanging nursery mobile: moon, stars and a cloud on threads from a wooden bar.
---

<svg class="mobile" viewBox="0 0 320 260" role="img" aria-label="A nursery mobile with a moon, stars and a cloud">
  <g class="bar">
    <line x1="160" y1="0" x2="160" y2="26" stroke="currentColor" stroke-opacity=".45" />
    <rect x="40" y="24" width="240" height="7" rx="3.5" fill="#c79a63" />
    <circle cx="160" cy="27.5" r="6" fill="#e2bf8c" />
  </g>
  <g class="swing s1">
    <line x1="62" y1="31" x2="62" y2="112" stroke="currentColor" stroke-opacity=".35" />
    <path d="M62 112l7.6 15.4 17 2.5-12.3 12 2.9 16.9L62 151l-15.2 8 2.9-16.9-12.3-12 17-2.5z" fill="#f2d48a" />
  </g>
  <g class="swing s2">
    <line x1="120" y1="31" x2="120" y2="150" stroke="currentColor" stroke-opacity=".35" />
    <path
      d="M96 186a17 17 0 0 1 4-33.5 22 22 0 0 1 41-2 15 15 0 0 1 5 35.5z"
      fill="#f6efe4"
    />
  </g>
  <g class="swing s3">
    <line x1="200" y1="31" x2="200" y2="96" stroke="currentColor" stroke-opacity=".35" />
    <path d="M216 98a40 40 0 1 0 22 66 34 34 0 0 1-22-66z" fill="#f2d48a" />
  </g>
  <g class="swing s4">
    <line x1="262" y1="31" x2="262" y2="160" stroke="currentColor" stroke-opacity=".35" />
    <path d="M262 160l5.6 11.4 12.6 1.8-9.1 8.9 2.1 12.5L262 189l-11.2 5.9 2.1-12.5-9.1-8.9 12.6-1.8z" fill="#e8b98c" />
  </g>
</svg>

<style>
  .mobile {
    width: min(230px, 62vw);
    height: auto;
    color: #f6efe4;
    overflow: visible;
  }
  .swing {
    transform-box: view-box;
    animation: sway 6s ease-in-out infinite alternate;
  }
  .s1 { transform-origin: 62px 31px; animation-delay: -1s; }
  .s2 { transform-origin: 120px 31px; animation-delay: -3s; animation-duration: 7s; }
  .s3 { transform-origin: 200px 31px; animation-delay: -2s; animation-duration: 8s; }
  .s4 { transform-origin: 262px 31px; animation-delay: -4s; }
  @keyframes sway {
    from { transform: rotate(-3deg); }
    to { transform: rotate(3deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .swing { animation: none; }
  }
</style>
