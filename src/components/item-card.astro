---
import OptionTitle from '@/components/option-title.astro'
import ShopLinks from '@/components/shop-links.astro'
import { links } from '@/data/links'
import { handmadeKey, type Item, optionKey, splitOption } from '@/data/registry'
import { tagLabels, tags } from '@/data/tags'
import { tutorialForItem } from '@/data/tutorials'

interface Props {
  item: Item
}
const { item } = Astro.props
const search = [item.name, ...item.options, item.make ?? '', item.group ? 'group gift' : '']
  .join(' ')
  .toLowerCase()
const makeKey = handmadeKey(item.id)
const tutorial = tutorialForItem[item.id]
---

<article class="item" id={`item-${item.id}`} data-item={item.id} data-one={item.one ? '' : undefined} data-search={search}>
  <header class="item-head">
    <h4 class="item-name">{item.name}</h4>
    {item.qty && <span class="qty">Need {item.qty}</span>}
    {item.group && <span class="group-tag">Group gift</span>}
    <span class="item-status" data-status hidden></span>
  </header>
  {item.group && <p class="group-note">Over $100, so a great one to go in on together. Claim it for your group.</p>}
  {item.note && <p class="item-note">{item.note}</p>}
  <ul class="opts">
    {
      item.options.map(option => {
        const { label, detail } = splitOption(option)
        const key = optionKey(item.id, option)
        return (
          <li class="opt" data-key={key} data-item={item.id} data-label={label}>
            <div class="opt-text">
              <span class="opt-label">
                <OptionTitle label={label} links={links[key]} />
                {tags[key]?.map(t => (
                  <span class={`badge badge-${t}`}>{tagLabels[t]}</span>
                ))}
              </span>
              {detail && <span class="opt-detail">{detail}</span>}
              <ShopLinks label="Also at" links={links[key]?.slice(1)} />
            </div>
            <div class="opt-action" data-action-slot>
              <span class="skeleton" aria-hidden="true" />
            </div>
          </li>
        )
      })
    }
    {
      item.make && (
        <li class="opt opt-make" data-key={makeKey} data-item={item.id} data-label={`Handmade: ${item.make}`}>
          <div class="opt-text">
            <span class="make-tag">Make it</span>
            <span class="opt-label">
              <OptionTitle label={item.make} links={links[makeKey]} />
            </span>
            <ShopLinks label="Also at" links={links[makeKey]?.slice(1)} />
            {tutorial && (
              <a class="how-to" href={`#tut-${tutorial}`}>
                How to make it
              </a>
            )}
          </div>
          <div class="opt-action" data-action-slot>
            <span class="skeleton" aria-hidden="true" />
          </div>
        </li>
      )
    }
  </ul>
  {item.restriction && <p class="restriction">{item.restriction}</p>}
</article>
